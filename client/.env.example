# Backend API URL
# Local development:
VITE_API_URL=http://localhost:3000
# Production (Vercel project environment variables):
# VITE_API_URL=https://clinicflow2-0-1.onrender.com

# Optional WebSocket URL override (defaults to VITE_API_URL origin if omitted)
# VITE_SOCKET_URL=http://localhost:3000

# Razorpay Checkout Public Key (Key ID only — never Secret)
# Test mode key (e.g. rzp_test_...)
VITE_RAZORPAY_KEY_ID=
