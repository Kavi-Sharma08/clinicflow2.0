# Environment mode ('development' or 'production')
NODE_ENV=development
PORT=3000

# Client origin (for CORS, redirects, and password reset links)
# Local: http://localhost:5173
# Production: https://clinicflow2-0.vercel.app
CLIENT_URL=http://localhost:5173

# Database configuration (Prisma 7 — urls live in prisma.config.js, not schema.prisma)
# DATABASE_URL  → used by PrismaClient at runtime (can be Neon pooled connection)
# DIRECT_URL    → used by prisma migrate deploy (must be Neon direct / non-pooled connection)
# Always append &connect_timeout=30 for Neon to survive cold-start delays
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Cloudinary configuration (required for document & avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email configuration (local development — Gmail/Nodemailer)
# Can use service: 'gmail' or custom host/port/secure
# If omitted in development, email contents (e.g. OTP, reset links) are logged to terminal
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Optional email settings:
# EMAIL_SERVICE=gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_FROM="ClinicFlow" <your-email@gmail.com>

# Email provider selection: 'gmail' or 'brevo'
# Defaults to: development → gmail, production → brevo
# EMAIL_PROVIDER=gmail

# Brevo configuration (production — HTTP API, no SMTP required)
# Only needed when EMAIL_PROVIDER=brevo (or NODE_ENV=production)
BREVO_API_KEY=

# Initial Admin Seeding (via `npm run seed:admin`)
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@clinicflow.com
ADMIN_SEED_PASSWORD=admin@123
ADMIN_SEED_PHONE=+910000000000

# Razorpay Payment Gateway Configuration
# Test mode credentials (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Route split capability (default false until formal approval)
RAZORPAY_ROUTE_ENABLED=false

# AI Microservice Configuration (Python FastAPI specialization model)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=5000