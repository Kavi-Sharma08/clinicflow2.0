# Environment mode ('development' or 'production')
NODE_ENV=development
PORT=3000

# Client origin (for CORS, redirects, and password reset links)
# Local: http://localhost:5173
# Production: https://clinicflow2-0.vercel.app
CLIENT_URL=http://localhost:5173

# Database configuration
# Local example:
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/clinicflow?schema=public"
DIRECT_URL="postgresql://postgres:admin123@localhost:5432/clinicflow?schema=public"

# Cloudinary configuration (required for document & avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email configuration (local development — Gmail/Nodemailer)
# Can use service: 'gmail' or custom host/port/secure
# If omitted in development, email contents (e.g. OTP, reset links) are logged to terminal
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Optional email settings:
# EMAIL_SERVICE=gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_FROM="ClinicFlow" <your-email@gmail.com>

# Email provider selection: 'gmail' or 'brevo'
# Defaults to: development → gmail, production → brevo
# EMAIL_PROVIDER=gmail

# Brevo configuration (production — HTTP API, no SMTP required)
# Only needed when EMAIL_PROVIDER=brevo (or NODE_ENV=production)
BREVO_API_KEY=

# Initial Admin Seeding (via `npm run seed:admin`)
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@clinicflow.com
ADMIN_SEED_PASSWORD=admin@123
ADMIN_SEED_PHONE=+910000000000