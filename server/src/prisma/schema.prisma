generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  VISITING
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DoctorDocumentType {
  MEDICAL_LICENSE
  GOVERNMENT_ID
  DEGREE_CERTIFICATE
  CERTIFICATION
  OTHER
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  PENDING_PAYMENT
  PAYMENT_EXPIRED
}

enum PaymentOrderStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentAttemptStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
}

enum SettlementStatus {
  NOT_APPLICABLE
  PENDING_COMPLETION
  ON_HOLD_PENDING_REVIEW
  ELIGIBLE
  QUEUED_FOR_PAYOUT
  TRANSFER_INITIATED
  SETTLED
  FAILED
  ON_HOLD
  REVERSED
}

enum RefundStatus {
  REVIEW_REQUESTED
  APPROVED
  REJECTED
  INITIATED
  SUCCESS
  FAILED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum LinkedAccountStatus {
  NOT_CREATED
  SUBMITTED
  KYC_PENDING
  ACTIVE
  SUSPENDED
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AppointmentUrgency {
  ROUTINE
  URGENT
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
  PASSWORD_RESET
  LOGIN_VERIFICATION
}

enum NotificationType {
  DOCTOR_PROFILE_SUBMITTED
  DOCTOR_PROFILE_VERIFIED
  DOCTOR_PROFILE_REJECTED
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_STARTED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_RESCHEDULED
  RESCHEDULE_REQUESTED
  RESCHEDULE_APPROVED
  RESCHEDULE_REJECTED
  QUEUE_UPDATED
  QUEUE_ETA_UPDATED
  QUEUE_YOUR_TURN
  QUEUE_POSITION_CHANGED
  PROFILE_UPDATED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

model User {
  id             String @id @default(cuid())
  firstName      String
  middleName     String?
  lastName       String?
  email          String @unique
  phone          String @unique
  alternatePhone String?
  gender         Gender
  dateOfBirth    DateTime?
  bloodGroup     BloodGroup?
  nationality    String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  profileImage   String?
  password       String
  role           Role
  accountStatus  AccountStatus @default(ACTIVE)
  emailVerified  Boolean @default(false)
  phoneVerified  Boolean @default(false)
  sessions       Session[]
  otps           UserOtp[]
  passwordResetTokens PasswordResetToken[]
  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
  notifications   Notification[]
  reviewedRescheduleRequests RescheduleRequest[]
  appointmentAudits          AppointmentAudit[]
  authorizedSettlements      DoctorSettlementLedger[]
  reviewedRefunds            RefundRecord[]
  financialAuditLogs         FinancialAuditLog[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([role])
  @@index([accountStatus])
  @@index([emailVerified])
}

model Session {
  id           String @id @default(cuid())
  userId       String
  refreshToken String? @unique
  accessToken  String?
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  isActive     Boolean @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([isActive])
  @@index([expiresAt])
}

model UserOtp {
  id           String @id @default(cuid())
  userId       String @unique
  otp          String
  purpose      OtpPurpose @default(SIGNUP_VERIFICATION)
  attempts     Int @default(0)
  resendCount  Int @default(0)
  lastResendAt DateTime?
  expiresAt    DateTime
  isUsed       Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose])
  @@index([expiresAt])
  @@index([isUsed])
}

model DoctorProfile {
  id                 String @id @default(cuid())
  userId             String @unique
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationNumber String @unique
  medicalCouncilName String
  specializations    String[]
  degrees            String[]
  certifications     String[]
  biography          String?
  consultationFee    Decimal @db.Decimal(10, 2)
  practiceStartDate  DateTime
  department         String
  designation        String?
  joiningDate        DateTime
  employmentType     EmploymentType
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  submittedAt        DateTime @default(now())
  availability       DoctorAvailability[]
  documents          DoctorDocument[]
  appointments       Appointment[]
  rescheduleRequests RescheduleRequest[]
  slug               String? @unique
  razorpayAccountId  String? @unique
  accountStatus      LinkedAccountStatus @default(NOT_CREATED)
  payoutsEnabled     Boolean @default(false)
  settlementLedgers  DoctorSettlementLedger[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([registrationNumber])
  @@index([verificationStatus])
  @@index([employmentType])
  @@index([department])
  @@index([slug])
}

model DoctorAvailability {
  id                   String @id @default(cuid())
  doctorId             String
  doctor               DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek            DayOfWeek
  startTime            String
  endTime              String
  isAvailable          Boolean @default(true)
  maxAppointments      Int
  consultationDuration Int @default(15)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([doctorId])
  @@index([dayOfWeek])
  @@index([isAvailable])
}

model DoctorDocument {
  id             String @id @default(cuid())
  doctorId       String
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  documentType   DoctorDocumentType
  fileUrl        String
  fileName       String?
  mimeType       String?
  fileSize       Int?
  remarks        String?
  uploadedAt     DateTime @default(now())
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([doctorId])
  @@index([documentType])
  @@index([verifiedAt])
}

model PatientProfile {
  id                    String @id @default(cuid())
  userId                String @unique
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId             String @unique
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelationship String?
  knownAllergies        String?
  chronicConditions     String?
  medicalNotes          String?
  appointments          Appointment[]
  rescheduleRequests    RescheduleRequest[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([patientId])
}

model Appointment {
  id                  String @id @default(cuid())
  doctorId            String
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patientId           String?
  patient             PatientProfile? @relation(fields: [patientId], references: [id], onDelete: Restrict)
  isGuest             Boolean @default(false)
  guestName           String?
  guestPhone          String?
  guestEmail          String?
  bookingReference    String? @unique
  isWalkIn            Boolean @default(false)
  guestTokenHash      String? @unique
  guestTokenExpiry    DateTime?
  guestTokenRevokedAt DateTime?
  appointmentDate     DateTime
  appointmentTime     DateTime
  scheduledTime       DateTime?
  estimatedTime       DateTime?
  actualStartTime     DateTime?
  actualEndTime       DateTime?
  queueNumber         Int?
  status              AppointmentStatus @default(BOOKED)
  urgency             AppointmentUrgency @default(ROUTINE)
  consultationFee     Decimal @db.Decimal(10, 2)
  notes               String?
  cancellationReason  String?
  completedAt         DateTime?
  cancelledAt         DateTime?
  paymentExpiresAt    DateTime?
  guestCheckoutTokenHash String? @unique
  guestCheckoutTokenExpiry DateTime?
  confirmedPaymentOrderId String? @unique
  confirmedPaymentOrder   PaymentOrder? @relation("ConfirmedAppointmentOrder", fields: [confirmedPaymentOrderId], references: [id])
  rescheduledToId     String?
  rescheduledTo       Appointment?       @relation("AppointmentReschedule", fields: [rescheduledToId], references: [id])
  rescheduledFrom     Appointment[]      @relation("AppointmentReschedule")
  rescheduleRequest   RescheduleRequest?
  audits              AppointmentAudit[]
  paymentOrders       PaymentOrder[]     @relation("AppointmentPaymentOrders")
  settlementLedger    DoctorSettlementLedger?
  refundRecords       RefundRecord[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([doctorId, appointmentDate, queueNumber])
  @@index([doctorId, appointmentDate])
  @@index([patientId])
  @@index([appointmentDate])
  @@index([status])
  @@index([urgency])
  @@index([rescheduledToId])
  @@index([bookingReference])
  @@index([guestTokenHash])
  @@index([paymentExpiresAt])
  @@index([guestCheckoutTokenHash])
}

model RescheduleRequest {
  id              String                  @id @default(cuid())
  appointmentId   String                  @unique
  appointment     Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId       String
  patient         PatientProfile          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId        String
  doctor          DoctorProfile           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  reason          String?
  requestedDate   DateTime?
  status          RescheduleRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?                   @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model AppointmentAudit {
  id             String             @id @default(cuid())
  appointmentId  String
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  action         String
  previousStatus AppointmentStatus?
  newStatus      AppointmentStatus?
  performedById  String?
  performedBy    User?              @relation(fields: [performedById], references: [id], onDelete: SetNull)
  reason         String?
  notes          String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([appointmentId])
  @@index([createdAt])
}


model Notification {
  id          String               @id @default(cuid())
  recipientId String
  recipient   User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  title       String
  message     String
  entityType  String?
  entityId    String?
  metadata    Json?

  readAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([type])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PaymentOrder {
  id                      String             @id @default(cuid())
  appointmentId           String
  appointment             Appointment        @relation("AppointmentPaymentOrders", fields: [appointmentId], references: [id], onDelete: Restrict)
  confirmedForAppointment Appointment?       @relation("ConfirmedAppointmentOrder")
  razorpayOrderId         String             @unique
  receipt                 String             // Matches appointment.id for recovery lookup
  grossAmountPaise        Int                // e.g. 150000 (₹1,500.00)
  currency                String             @default("INR")
  commissionRateBps       Int                @default(500) // 5.00%
  platformFeePaise        Int                // e.g. 7500 (₹75.00)
  doctorSharePaise        Int                // e.g. 142500 (₹1,425.00)
  gatewayFeePaise         Int?
  gatewayTaxPaise         Int?
  status                  PaymentOrderStatus @default(PENDING)
  confirmedPaymentId      String?            // The successful pay_xxx ID
  refundedAmountPaise     Int                @default(0)
  paymentAttempts         PaymentAttempt[]
  settlementLedger        DoctorSettlementLedger?
  refundRecords           RefundRecord[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([appointmentId])
  @@index([razorpayOrderId])
  @@index([receipt])
  @@index([status])
}

model PaymentAttempt {
  id                   String               @id @default(cuid())
  paymentOrderId       String
  paymentOrder         PaymentOrder         @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  razorpayPaymentId    String?              @unique // pay_xxx
  status               PaymentAttemptStatus @default(INITIATED)
  amountPaise          Int
  currency             String               @default("INR")
  method               String?              // upi, card, netbanking, etc.
  bank                 String?
  wallet               String?
  vpa                  String?
  errorCode            String?
  errorDescription     String?
  errorSource          String?
  errorStep            String?
  errorReason          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([paymentOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
}

model DoctorSettlementLedger {
  id                   String             @id @default(cuid())
  doctorId             String
  doctor               DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointmentId        String             @unique
  appointment          Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  paymentOrderId       String             @unique
  paymentOrder         PaymentOrder       @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  allocatedAmountPaise Int
  settlementStatus     SettlementStatus   @default(PENDING_COMPLETION)
  transferId           String?            @unique // Route transfer trf_xxxx
  transferInitiatedAt  DateTime?
  transferSettledAt    DateTime?
  reversalId           String?
  failureReason        String?
  authorizedById       String?
  authorizedBy         User?              @relation(fields: [authorizedById], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([doctorId, settlementStatus])
  @@index([settlementStatus])
  @@index([transferId])
}

model RefundRecord {
  id                   String             @id @default(cuid())
  appointmentId        String
  appointment          Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  paymentOrderId       String
  paymentOrder         PaymentOrder       @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  idempotencyKey       String             @unique // Sent via X-Refund-Idempotency
  amountPaise          Int
  reason               String
  status               RefundStatus       @default(REVIEW_REQUESTED)
  razorpayRefundId     String?            @unique // rfn_xxxx
  reviewedById         String?
  reviewedBy           User?              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([appointmentId])
  @@index([paymentOrderId])
  @@index([status])
  @@index([idempotencyKey])
}

model WebhookEvent {
  id                   String                  @id @default(cuid())
  eventId              String                  @unique // x-razorpay-event-id
  eventType            String
  payloadSummary       Json
  status               WebhookProcessingStatus @default(RECEIVED)
  attempts             Int                     @default(0)
  maxAttempts          Int                     @default(5)
  nextRetryAt          DateTime?
  lockedAt             DateTime?
  lockedBy             String?
  errorMessage         String?
  receivedAt           DateTime                @default(now())
  processedAt          DateTime?

  @@index([eventId])
  @@index([eventType])
  @@index([status])
  @@index([nextRetryAt])
  @@index([lockedAt])
}

model FinancialAuditLog {
  id                   String             @id @default(cuid())
  action               String
  performedById        String?
  performedBy          User?              @relation(fields: [performedById], references: [id], onDelete: SetNull)
  targetEntity         String
  targetId             String
  previousState        Json?
  newState             Json?
  reason               String?
  metadata             Json?
  createdAt            DateTime           @default(now())

  @@index([targetEntity, targetId])
  @@index([action])
  @@index([createdAt])
}
